[Unit]
Description=Dirextalk isolated Core runner cgroup delegate (%i)
RequiresMountsFor=/sys/fs/cgroup
After=local-fs.target systemd-sysusers.service
Before=docker.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
User=dirextalk-core-runner
Group=dirextalk-core-runner
Slice=%i-core-runner.slice
Delegate=cpu memory pids
DelegateSubgroup=keeper
ExecStart=/usr/bin/sleep infinity
Restart=always
RestartSec=2s
TasksMax=infinity

[Install]
WantedBy=multi-user.target
