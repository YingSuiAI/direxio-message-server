{
  "id": "geolibre-deploy",
  "version": "0.1.0",
  "schema_version": "recipe/v1",
  "content_digest": "e607eaa6c4160b36e887bc304c73e5a9b44bf2bff7159a86a4030f286ea795f0",
  "minimum_core_version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": {"type": "object", "properties": {"package": {"type": "string"}}},
      "fixture": {
        "type": "object",
        "properties": {
          "oci_digest": {"type": "string"},
          "name": {"type": "string"},
          "host_address": {"type": "string"},
          "host_port": {"type": "integer"},
          "container_port": {"type": "integer"},
          "restart_policy": {"type": "string"},
          "probe": {"type": "string"},
          "resource": {"type": "string"}
        }
      },
      "repository": {"type": "string"}
    }
  },
  "output_schema": {"type": "object"},
  "intent_tags": ["fixture", "recipe"],
  "required_target_capabilities": ["target.aws_ec2_instance", "transport.aws_ssm"],
  "network_access": {
    "allowed": true,
    "purpose": "fixture-container-download",
    "endpoints": ["public_https_egress", "target_local:service"]
  },
  "secret_purposes": [],
  "stages": [
    {
      "stage_key": "inspect",
      "title": "Inspect fixture target",
      "kind": "target.inspect",
      "risk": "R0",
      "gate": "none",
      "steps": [{"step_key": "inspect-target", "kind": "target.inspect", "template": {}, "timeout_seconds": 30, "idempotency_marker": "inspect"}],
      "timeout_seconds": 60
    },
    {
      "stage_key": "bootstrap",
      "title": "Bootstrap fixture packages",
      "kind": "package.ensure",
      "risk": "R2",
      "gate": "remote_privileged_execution",
      "depends_on": ["inspect"],
      "steps": [{"step_key": "ensure-package", "kind": "package.ensure", "template": {"package_ref": "${target.package}"}, "timeout_seconds": 120, "idempotency_marker": "bootstrap", "network_grants": ["public_https_egress"]}],
      "timeout_seconds": 180
    },
    {
      "stage_key": "apply",
      "title": "Apply fixture container",
      "kind": "container.apply",
      "risk": "R2",
      "gate": "remote_privileged_execution",
      "depends_on": ["bootstrap"],
      "steps": [{
        "step_key": "apply-container",
        "kind": "container.apply",
        "template": {
          "image_digest": "${fixture.oci_digest}",
          "name": "${fixture.name}",
          "host_address": "${fixture.host_address}",
          "host_port": "${fixture.host_port}",
          "container_port": "${fixture.container_port}",
          "restart_policy": "${fixture.restart_policy}"
        },
        "timeout_seconds": 180,
        "idempotency_marker": "apply",
        "network_grants": ["public_https_egress"]
      }],
      "timeout_seconds": 240
    },
    {
      "stage_key": "probe",
      "title": "Probe fixture service",
      "kind": "http.probe",
      "risk": "R0",
      "gate": "none",
      "depends_on": ["apply"],
      "steps": [{"step_key": "probe-http", "kind": "http.probe", "template": {"probe_ref": "${fixture.probe}"}, "timeout_seconds": 30, "idempotency_marker": "probe", "network_grants": ["target_local:service"]}],
      "timeout_seconds": 60
    }
  ],
  "allowed_step_kinds": ["container.apply", "http.probe", "package.ensure", "target.inspect"],
  "metadata": {
    "fixture_source_commit": "9e0f6a4d4d0e4ef2c42df7a0f8d8b2f1a4a7e6d1",
    "fixture_oci_digest": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  }
}
